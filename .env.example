// Estas variables se pueden obtener en la configuración de tu proyecto de Firebase. Para obtenerlas, ve a la consola de Firebase, selecciona tu proyecto y navega a "Configuración del proyecto" > "General" > "Tus aplicaciones" > "Configurar Firebase para la web". Allí encontrarás las variables necesarias para completar este archivo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

// Variables para crear un usuario administrador en la base de datos
// solo se deben completar si se desea crear un usuario administrador en la base de datos. Si no se desea crear un usuario administrador, se pueden dejar vacías.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

// Variable para usar emuladores de Firebase (true o false)
// solo se debe completar si se desea usar emuladores de Firebase. Si no se desea usar emuladores, se puede dejar vacía.
SEED_USE_EMULATORS=
VITE_USE_EMULATORS=

