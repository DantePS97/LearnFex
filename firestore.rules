rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hay una sesion de Firebase Auth (sin mirar el perfil en Firestore).
    function haySesion() {
      return request.auth != null;
    }

    // El usuario NO esta desactivado. Un perfil que todavia no existe cuenta como activo
    // (en el registro, Auth crea la cuenta antes que createUserProfile cree usuarios/{uid}),
    // y un perfil sin campo `estado` tambien. Solo `estado == 'inactivo'` bloquea.
    // Costo: exists() + get() del mismo documento usuarios/{uid}; Firestore los cobra como
    // UNA lectura por solicitud aunque la regla lo mencione varias veces.
    function estaActivo() {
      return !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('estado', 'activo') != 'inactivo';
    }

    // Sesion valida Y cuenta no desactivada. Es la puerta de casi todas las reglas.
    function estaAutenticado() {
      return haySesion() && estaActivo();
    }

    function esPropioUsuario(usuarioId) {
      return estaAutenticado() && request.auth.uid == usuarioId;
    }

    // Un administrador desactivado deja de serlo (pasa por estaAutenticado()). Un
    // administrador activo no cambia: sigue leyendo usuarios/{uid}.data.rol como antes.
    function esAdministrador() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    function esActualizacionDePerfil() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'apellido', 'colegio']);
    }

    // Elemento del arreglo `preguntas` de un cuestionario: { preguntaId, orden } (quizService).
    function esPreguntaDeCuestionarioValida(pregunta) {
      return pregunta is map &&
        pregunta.keys().hasOnly(['preguntaId', 'orden']) &&
        pregunta.keys().hasAll(['preguntaId', 'orden']) &&
        pregunta.preguntaId is string && pregunta.preguntaId.size() <= 100 &&
        pregunta.orden is int;
    }

    // Forma exacta que escribe createQuiz (quizRepository). Las reglas no pueden recorrer
    // listas, por eso del arreglo `preguntas` se revisan la cantidad, el primer y el ultimo elemento.
    function esCuestionarioValido(datos) {
      return datos.keys().hasOnly(['titulo', 'descripcion', 'tipo', 'areaId', 'duracion', 'estado', 'preguntas', 'fechaCreacion']) &&
        datos.keys().hasAll(['titulo', 'tipo', 'estado', 'preguntas', 'fechaCreacion']) &&
        datos.titulo is string && datos.titulo.size() <= 120 &&
        datos.tipo in ['cuestionario', 'simulacro'] &&
        datos.estado == 'activo' &&
        datos.preguntas is list && datos.preguntas.size() >= 1 && datos.preguntas.size() <= 100 &&
        esPreguntaDeCuestionarioValida(datos.preguntas[0]) &&
        esPreguntaDeCuestionarioValida(datos.preguntas[datos.preguntas.size() - 1]) &&
        (!('descripcion' in datos) || (datos.descripcion is string && datos.descripcion.size() <= 500)) &&
        (!('duracion' in datos) || datos.duracion is number) &&
        (!('areaId' in datos) || datos.areaId == null || (datos.areaId is string && datos.areaId.size() <= 100)) &&
        datos.fechaCreacion == request.time;
    }

    match /usuarios/{usuarioId} {
      // Excepcion deliberada: el propietario lee su perfil AUNQUE este inactivo (solo haySesion, sin
      // estaActivo), porque AuthContext lo lee para descubrir que esta inactivo y cerrarle la sesion.
      // Es lo unico que un inactivo puede hacer; ademas no suma lecturas de reglas.
      allow read: if (haySesion() && request.auth.uid == usuarioId) || esAdministrador();

      allow create: if esPropioUsuario(usuarioId) &&
        request.resource.data.rol == 'estudiante' &&
        request.resource.data.estado == 'activo' &&
        request.resource.data.xp == 0 &&
        request.resource.data.nivel == 1 &&
        request.resource.data.consentimientoDatos == true &&
        request.resource.data.fechaConsentimiento == request.time;

      allow update: if esAdministrador() || (esPropioUsuario(usuarioId) && esActualizacionDePerfil());

      allow delete: if false;

      match /logrosObtenidos/{logroId} {
        allow read: if esPropioUsuario(usuarioId) || esAdministrador();
        allow create: if false;
        allow update, delete: if false;
      }
    }

    match /areas/{areaId} {
      allow read: if estaAutenticado();
      allow write: if esAdministrador();
    }

    match /preguntas/{preguntaId} {
      allow read: if estaAutenticado();
      allow write: if esAdministrador();
    }

    match /cuestionarios/{cuestionarioId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado() && esCuestionarioValido(request.resource.data);
      allow update, delete: if esAdministrador();
    }

    match /resultados/{resultadoId} {
      allow read: if estaAutenticado() &&
        (resource.data.usuarioId == request.auth.uid || esAdministrador());

      allow create: if false;

      allow update, delete: if false;

      match /respuestas/{respuestaId} {
        allow read: if estaAutenticado() &&
          (resource.data.usuarioId == request.auth.uid || esAdministrador());

        allow create: if false;

        allow update, delete: if false;
      }
    }

    match /ranking/{rankingId} {
      allow read: if estaAutenticado();
      // Solo escribe la Cloud Function calificarPrueba con Admin SDK (no pasa por las reglas).
      allow write: if false;
    }

    match /estadisticas_progreso/{statId} {
      allow read: if estaAutenticado() &&
        (resource.data.usuarioId == request.auth.uid || esAdministrador());

      // El id es `{uid}_{areaId}` (upsertEstadistica): el uid de Firebase Auth no lleva
      // guion bajo, asi que lo que va antes del primero es el uid del propietario.
      allow create, update: if estaAutenticado() &&
        statId.split('_')[0] == request.auth.uid &&
        request.resource.data.usuarioId == request.auth.uid;

      allow delete: if false;
    }

    match /logros/{logroId} {
      allow read: if estaAutenticado();
      allow write: if esAdministrador();
    }

    // Estadisticas agregadas del panel de administracion
    match /estadisticas_plataforma/{docId} {
      allow read: if esAdministrador();
      allow write: if false;
    }

    // Configuracion general de la aplicacion (nombre, descripcion, email de soporte)
    match /configuracion/{docId} {
      allow read: if estaAutenticado();
      allow write: if esAdministrador();
    }
  }
}
